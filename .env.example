# --- Model endpoint (default: Nebius Token Factory) ---
NEBIUS_API_KEY=your_key_here
# Verify the exact model ID in the Token Factory playground
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# To use another OpenAI-compatible endpoint (e.g. local Ollama) instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=<model name>

# --- Web search (optional) ---
TAVILY_API_KEY=

# --- Identity ---
AI_NAME=Ev
# personal (phone) or professional (laptop). Separate memory for each.
PROFILE=personal
BRIEFING_TIME=08:30

# --- Voice (optional, see README) ---
# Leave WAKEWORD empty for press-Enter-to-talk
WAKEWORD=
PIPER_VOICE=
MIC_THRESHOLD=500
WHISPER_MODEL=small
